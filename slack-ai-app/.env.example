# Slack credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-level-token

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Optional configuration
MODEL=gpt-4o-mini
SYSTEM_PROMPT=You are a helpful Slack assistant that provides concise, actionable answers.
MAX_TOKENS=600

# Product analytics (optional). Analytics is off until ANALYTICS_API_KEY is set.
# The key is the project API key of any PostHog-compatible capture endpoint.
ANALYTICS_API_KEY=
# Capture endpoint base URL. Defaults to https://us.i.posthog.com.
# Must use https; plain http is accepted only for localhost and 127.0.0.1.
ANALYTICS_HOST=https://us.i.posthog.com
# Comma-separated Slack channel ids and user ids that must never be tracked.
ANALYTICS_TEST_CHANNEL_IDS=
ANALYTICS_TEST_USER_IDS=
